# GEMINI_API_KEY: Optional if AI features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# QuickDrop Storage Configuration (Optional Cloudflare R2 / S3 Object Storage)
# If not provided, QuickDrop uses built-in server-side temporary disk storage.
# Cloudflare R2 provides 10 GB free storage with $0 egress fees:
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="quickdrop-files"
# R2_PUBLIC_URL="" # Optional, if using a custom domain or presigned URLs
